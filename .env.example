# ============================================================
# 6G Digital Immunity - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.

# --- Network Topology ---
TELEMETRY_NET_SUBNET=172.28.0.0/16
INFERENCE_NET_SUBNET=172.29.0.0/16
ACTUATION_NET_SUBNET=172.30.0.0/16

# --- Service Addresses ---
OSMO_BSC_HOST=172.28.0.50
OSMO_BSC_PORT=3002
OSMO_BSC_VTY_PORT=4242
OSMO_BTS_HOST=172.30.0.100
OSMO_BTS_VTY_PORT=4242

DSF_HOST=172.29.0.20
DSF_GRPC_PORT=50052

LLM_AGENT_HOST=172.29.0.30

NETWORK_ACTUATOR_HOST=172.29.0.21
NETWORK_ACTUATOR_GRPC_PORT=50054

KAFKA_BOOTSTRAP_SERVERS=172.29.0.10:9092
ZOOKEEPER_HOST=172.29.0.11
ZOOKEEPER_PORT=2181

PROMETHEUS_HOST=172.28.0.70
PROMETHEUS_PORT=9090

# --- CUE Schema Validation ---
CUE_BIN_PATH=/usr/local/bin/cue
SCHEMA_DIR=/app/schemas

# --- DSF CBF Parameters ---
CBF_STATE_DIM=8
CBF_ALPHA=0.1
CBF_TAU_MIN_MS=500
CBF_ZENO_COOLDOWN_MS=2000

# --- Certificates (mTLS) ---
CERT_DIR=/app/certs
CA_CERT_PATH=/app/certs/ca.crt
DSF_SERVER_CERT=/app/certs/dsf-server.crt
DSF_SERVER_KEY=/app/certs/dsf-server.key
LLM_CLIENT_CERT=/app/certs/llm-agent.crt
LLM_CLIENT_KEY=/app/certs/llm-agent.key
ACTUATOR_CERT=/app/certs/osmocom-actuator.crt
ACTUATOR_KEY=/app/certs/osmocom-actuator.key

# --- TelcoLLM Agent ---
LLM_MODEL_PATH=/app/models/telco-llm
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
INTENT_COOLDOWN_S=5.0

# --- Telemetry ---
KAFKA_TELEMETRY_TOPIC=telecomm.bts.telemetry
KAFKA_INTENT_TOPIC=telecomm.llm.intents
TELEMETRY_EXPORT_INTERVAL_MS=1000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
